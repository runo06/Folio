# Copia este archivo como .env y cambia los valores.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# --- Django ---
# Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción (HTTPS) debe ser True para que la cookie solo viaje cifrada
JWT_COOKIE_SEGURA=False

# --- PostgreSQL ---
POSTGRES_DB=folio
POSTGRES_USER=folio
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- Límites de Folio ---
FOLIO_TAMANO_MAXIMO_MB=25
FOLIO_MAX_DOCUMENTOS_POR_USUARIO=50
