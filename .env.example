# Copia este archivo como .env y cambia los valores.
# El archivo .env NUNCA se sube a git (está en .gitignore).

# --- Django ---
# Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción (HTTPS) debe ser True para que la cookie solo viaje cifrada
JWT_COOKIE_SEGURA=False

# --- PostgreSQL ---
POSTGRES_DB=folio
POSTGRES_USER=folio
POSTGRES_PASSWORD=cambia-esta-contrasena

# --- Límites de Folio ---
FOLIO_TAMANO_MAXIMO_MB=25
FOLIO_MAX_DOCUMENTOS_POR_USUARIO=50

# --- Procesamiento con IA (fase 2) ---
# Clave gratuita en https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
FOLIO_EMBEDDINGS_MODELO=gemini-embedding-001
# Tamaño de cada fragmento y cuánto se repite con el siguiente (en caracteres)
FOLIO_FRAGMENTO_TAMANO=1200
FOLIO_FRAGMENTO_SOLAPE=200

# --- Chat (fase 3) ---
FOLIO_CHAT_MODELO=gemini-3.5-flash
# Respaldo si el principal está saturado antes de empezar a responder (vacío = sin respaldo)
FOLIO_CHAT_MODELO_RESPALDO=gemini-3.5-flash-lite
